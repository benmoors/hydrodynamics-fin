Project/

# Project second-brain wiki: summaries of Monash course notebooks and the brief.
# The repo is public, so it stays local (see wiki/CLAUDE.md).
wiki/

# --- SWD acquisition ---
# Backups live OUTSIDE this repo (see SWD/README.md). These entries are a
# second line of defence in case one is ever copied in by mistake.
SWD/backup/
*.reg
swdy-licence*

# SWD fin polars
SWD/data/fin_polars.csv

# Per-element contact-patch geometry: literal scale-1 hull coordinates, in metres,
# ~59k vertices per board. That is a reproducible description of a board's wetted
# shape, and the library holds designs attributable to named third parties. The
# derived scalar CSVs beside it (elements, sub_elements, operating_points, board)
# carry the physics the project actually needs and are committed; this one is the
# geometry itself, so it stays local. Same reasoning as dropping shaper_name.
SWD/data/**/geometry_contact.csv

# Raw SWD binaries are large (biblio/ is 629 MB) and are the user's own
# licensed data. Only the extracted CSVs belong in version control.
*.fynrhydro
*.fynbs
*.fynbdi
*.fynvague
*.fynlines
*.fyncoup
*.fyntail
*.fynsurfr
*.fyncplroc
*.fynstat
*.fyndyn
*.fynrail
*.fynscoup
*.fynsrail

# Working files
SWD/scratch/
*.tmp
__pycache__/
.ipynb_checkpoints/

# --- Phase 2 automation runtime artefacts ---
# control-map.csv holds WM_GETTEXT output from every SWD control, and the PNGs
# are renders of the app window. Both can carry the library path (username and
# tenant) and board/designer names - the same leak class round 1 fixed by
# dropping shaper_name. Regenerated on every run, so nothing is lost.
SWD/tools/phase2/logs/
SWD/tools/phase2/control-map*.csv
# The two rules above are path-literal and only cover the DEFAULT locations.
# -LogDir and -Dir are caller-supplied, so a log or a window render written
# anywhere else under phase2 would have been tracked. (SQA W15, W16.)
SWD/tools/phase2/**/*.log
SWD/tools/phase2/**/*.png

# --- Computed views ---
# Everything under a board's computed-data/ folder is produced from the extracted
# CSVs beside it, by `python SWD/tools/make_computed_view.py` and
# `python SWD/model/trajectory.py`. The extracted data itself stays tracked.
# NOTE: default_shortboard's computed-data/ files are already tracked and stay
# that way by choice, so this rule only keeps NEW computed views out of the tree.
SWD/data/**/computed-data/

# --- Test-run artefacts ---
# pytest writes its own self-ignoring .gitignore inside this dir; being explicit
# means the rule survives that file being cleaned away.
.pytest_cache/
# mutate.py stages mutants under %TEMP%, but falls back to this in-repo path when
# TEMP is unset (SWD/tools/tests/mutate.py:29-30).
SWD/tools/tests/_mutants/

# --- Claude Code config ---
# Shared: skills, path-scoped rules, and settings.json (permission denies only).
# Personal: settings.local.json holds each person's absolute autoMemoryDirectory.
.claude/*
!.claude/skills/
!.claude/rules/
!.claude/settings.json

# --- Obsidian vault (repo root is the vault) ---
# Per-person window layout, and the Local REST API plugin's data.json, which
# holds that person's API key and TLS private key. Never commit either.
.obsidian/workspace*.json
.obsidian/plugins/*/data.json
.trash/

# Research drafts from other AI tools (Gemini, Fable). Several claims in them
# were refuted; see AI-USE.md errors ledger. Kept local, not published.
FABLE-RES.md
GEM-RES.docx

# Pester's -CI switch writes an NUnit report to the working directory. It embeds
# user=, user-domain= and machine-name=, so it is a repo rule R9 leak, not just
# clutter. An SQA agent produced one at the repo root on 2026-09-02.
testResults.xml
**/testResults.xml
